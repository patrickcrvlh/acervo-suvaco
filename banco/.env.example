# Modelo do arquivo de configuração do banco.
#
# Como usar:
#   1. copie este arquivo e renomeie a cópia para  .env  (na mesma pasta)
#   2. preencha com os dados do SEU PostgreSQL
#   3. nunca suba o .env — o .gitignore já impede
#
# Este arquivo (.env.example) pode subir, porque não tem senha nenhuma.

PGHOST=localhost
PGPORT=5432
PGDATABASE=acervo_suvaco
PGUSER=postgres
PGPASSWORD=coloque_sua_senha_aqui
